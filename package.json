{
  "name": "ds-evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "eval": "tsx evals/run.ts",
    "log": "tsx evals/log.ts",
    "gallery": "vite --config gallery/vite.config.ts --open",
    "gallery:build": "vite build --config gallery/vite.config.ts",
    "test": "tsx --test src/task.test.ts src/run-suite.test.ts src/dataset.test.ts evals/scorers/scorers.test.ts gallery/server/runs.test.ts gallery/src/expectations.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p gallery"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "braintrust": "^3.44.0",
    "motion": "^14.14.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dom-accessibility-api": "^0.7.1",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
